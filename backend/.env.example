# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
# Get this from: MongoDB Atlas dashboard -> Connect -> Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/leaddesk-mini

# JWT signing secret - generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Admin account seed credentials (used only by npm run seed:admin)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_PASSWORD=

# The deployed frontend URL, used to lock down CORS
CORS_ORIGIN=http://localhost:5173
